DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSL=false
PORT=3000
NODE_ENV=development
# Use a random secret of at least 32 bytes; do not use a placeholder value.
JWT_SECRET=
# Required positive token lifetime, for example 1h or 1d (maximum 365d).
JWT_EXPIRES_IN=
